{
  "$schema": "https://raw.githubusercontent.com/c33leron/BreakCurl/main/breakcurl.config.schema.json",
  "profile": "full",
  "maxCases": 90,
  "onlyPaths": ["$.email", "$.age", "$.profile"],
  "excludePaths": ["$.profile.internalNote"],
  "expectAuth": true,
  "customCases": [
    {
      "name": "Email without a domain must be rejected",
      "path": "$.email",
      "operation": "set",
      "value": "qa@",
      "expect": "reject"
    },
    {
      "name": "Unknown enum value must be rejected",
      "path": "$.profile.status",
      "operation": "set",
      "value": "BREAKCURL_UNKNOWN",
      "expect": "reject"
    },
    {
      "name": "Optional field may be removed",
      "path": "$.profile.middleName",
      "operation": "remove",
      "expect": "accept"
    }
  ]
}
